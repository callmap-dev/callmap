    "base": {
      "checkout/checkout.go": "package checkout\n\nimport \"example.com/shop/money\"\n\nfunc Total(prices []int) string {\n\tsum := 0\n\tfor _, price := range prices {\n\t\tsum += price\n\t}\n\treturn money.Format(sum)\n}\n\nfunc LegacyTotal(prices []int) string {\n\treturn Total(prices)\n}\n",
      "money/money.go": "package money\n\nimport \"fmt\"\n\nfunc Format(cents int) string {\n\treturn fmt.Sprintf(\"%d EUR\", whole(cents))\n}\n\nfunc whole(cents int) int {\n\treturn cents / 100\n}\n"
    },
    "branch": {
      "checkout/audit.go": "package checkout\n\nimport \"example.com/shop/gen\"\n\nfunc Audit(cents int) {\n\tgen.Log(cents)\n}\n",
      "checkout/checkout.go": "package checkout\n\nimport \"example.com/shop/money\"\n\nfunc Total(prices []int) string {\n\tsum := 0\n\tfor _, price := range prices {\n\t\tsum += price\n\t}\n\treturn money.Format(money.Round(sum))\n}\n\nfunc Receipt(prices []int) string {\n\treturn \"Total: \" + Total(prices)\n}\n",
      "checkout/pay.go": "package checkout\n\ntype Payer interface {\n\tPay(cents int) error\n}\n\ntype Card struct{}\n\nfunc (c Card) Pay(cents int) error {\n\treturn nil\n}\n\ntype Wallet struct{}\n\nfunc (w *Wallet) Pay(cents int) error {\n\treturn nil\n}\n\nfunc Charge(payer Payer) error {\n\treturn payer.Pay(100)\n}\n",
      "money/money.go": "package money\n\nimport \"fmt\"\n\nfunc Format(cents int) string {\n\treturn fmt.Sprintf(\"%d.%02d EUR\", whole(cents), cents%100)\n}\n\nfunc Round(cents int) int {\n\treturn whole(cents+50) * 100\n}\n\nfunc whole(cents int) int {\n\treturn cents / 100\n}\n"
    }
  }
