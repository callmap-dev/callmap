      "apps/admin/src/dashboard.ts": "import { rounded } from '@shop/money';\nimport { toast } from 'sonner';\nimport { format } from '@/format';\n\nexport const dashboard = (count: number): string => `Orders: ${format(rounded(count))}`;\n\nexport const notify = (count: number): void => toast(dashboard(count));\n",
      "apps/admin/src/format.ts": "export const format = (count: number): string => `${count} orders`;\n",
      "apps/web/src/checkout.ts": "import { format } from '@/format';\nimport { taxed } from '@/tax';\n\nexport const checkout = (cents: number): string => format(taxed(cents));\n",
      "apps/web/src/format.ts": "export const format = (cents: number): string => `$${(cents / 100).toFixed(2)}`;\n",
      "apps/web/src/tax.ts": "import { rounded } from '@shop/money';\n\nexport const taxed = (cents: number): number => rounded(cents * 1.2);\n",
      "packages/money/src/index.ts": "export const rounded = (amount: number): number => Math.round(amount);\n",
      "scripts/counts.ts": "export const counts = (): readonly number[] => [1, 2, 3];\n",
      "scripts/seed.ts": "import { counts } from './counts';\n\nexport const seed = (): readonly number[] => counts();\n"
    }
