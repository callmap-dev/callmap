    "branch": {
      "app/models/order.rb": "class Order < ActiveRecord::Base\n  def total\n    1\n  end\n\n  def label\n    \"order\".upcase\n  end\nend\n",
      "app/models/receipt.rb": "class Receipt\n  def initialize(total)\n    @total = total\n  end\n\n  def text\n    @total.to_s\n  end\nend\n",
      "app/services/checkout.rb": "class Checkout\n  def initialize\n    @order = Order.find(1)\n  end\n\n  def run\n    receipt = Receipt.new(@order.total)\n    receipt.text\n  end\n\n  def guess\n    order = Order.find_by(id: 1)\n    order = load_order if order.nil?\n    order.total\n  end\n\n  def load_order\n    Order.new\n  end\n\n  def made\n    Order.new.label\n  end\nend\n"
    }
  }
