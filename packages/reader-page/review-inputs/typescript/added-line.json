  "sources": {
    "base": {
      "src/cart.ts": "import { format, round } from './money';\n\nexport const subtotal = (prices: readonly number[]): number =>\n  round(prices.reduce((sum, price) => sum + price, 0));\n\nexport const taxed = (prices: readonly number[]): number => subtotal(prices) * 1.25;\n\nexport const receipt = (prices: readonly number[]): string => {\n  const total = taxed(prices);\n  return format(total);\n};\n\nexport const label = (name: string): string => name.toUpperCase();\n"
    },
    "branch": {
      "src/alerts.ts": "import { format } from './money';\nimport type { Channel } from './notify';\n\nexport const alert = (channel: Channel, amounts: readonly number[]): string[] =>\n  amounts.map((amount) => channel.send(format(amount)));\n\nexport const relay = (raw: string): void => {\n  JSON.parse(raw).notify();\n};\n",
      "src/cart.ts": "import { format, round } from './money';\n\nexport const subtotal = (prices: readonly number[]): number =>\n  round(prices.reduce((sum, price) => sum + price, 0));\n\nexport const taxed = (prices: readonly number[]): number => subtotal(prices) * 1.25;\n\nexport const receipt = (prices: readonly number[]): string => {\n  const total = taxed(prices);\n  console.log(total);\n  return format(total);\n};\n\nexport const label = (name: string): string => name.toUpperCase();\n",
      "src/checkout.ts": "import { receipt } from './cart';\n\nexport const checkout = (prices: readonly number[]): string => receipt(prices);\n",
      "src/money.ts": "export const format = (amount: number): string => `${round(amount).toFixed(2)} EUR`;\n\nexport const round = (amount: number): number => Math.round(amount * 100) / 100;\n",
      "src/notify.ts": "export interface Channel {\n  send(text: string): string;\n}\n\nexport class Mail implements Channel {\n  send(text: string): string {\n    return `mail: ${text}`;\n  }\n}\n\nexport class Sms implements Channel {\n  send(text: string): string {\n    return `sms: ${text}`;\n  }\n}\n",
      "src/report.ts": "export const heading = (title: string): string => title.toUpperCase();\n\nexport const report = (title: string): string => `${heading(title)}\\n`;\n",
      "src/tax/rate.ts": "export const vatRate = (): number => 0.25;\n"
    }
  }
}
