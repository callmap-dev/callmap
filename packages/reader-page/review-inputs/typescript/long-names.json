      "src/settlement_reconciliation_adjustments/outstanding_balances.ts": "import { roundToCents } from '../statements/rounding';\n\nexport const reconcileOutstandingSettlementAdjustments = (amounts: readonly number[]): number =>\n  roundToCents(amounts.filter((amount) => amount !== 0).reduce((sum, amount) => sum + amount, 0));\n",
      "src/settlement_reconciliation_adjustments/quarterly_summaries.ts": "import { roundToCents } from '../statements/rounding';\nimport { reconcileOutstandingSettlementAdjustments } from './outstanding_balances';\n\nexport const summariseQuarterlyReconciliationAdjustments = (\n  quarters: readonly number[][],\n): number =>\n  roundToCents(\n    quarters\n      .map(reconcileOutstandingSettlementAdjustments)\n      .reduce((sum, amount) => sum + amount, 0),\n  );\n",
      "src/statements/rounding.ts": "export const roundToCents = (amount: number): number => Math.round(amount * 100) / 100;\n"
    }
